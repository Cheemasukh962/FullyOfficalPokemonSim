{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Flask Server",
            "type": "shell",
            "command": ".venv/Scripts/python.exe",
            "args": ["source/api/server.py"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Serving Flask.*",
                    "endsPattern": "^.*$"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
